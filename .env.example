# Standard send amount for all corridor comparisons
SEND_AMOUNT=1000

# Tier A API keys (free tiers)
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here
OPEN_EXCHANGE_RATES_APP_ID=your_open_exchange_rates_app_id_here

# Optional alerting (Slack incoming webhook or generic webhook URL)
ALERT_WEBHOOK_URL=

# Playwright browser settings
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=45000

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2

# Live API server (on-demand rates for WordPress/backend)
API_PORT=8000
LIVE_API_CACHE_SECONDS=120
LIVE_API_SKIP_BROWSER=true
LIVE_API_CORS_ORIGINS=*
LIVE_API_WARM_CACHE=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log
